{
  "name": "replypilot",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @replypilot/api --filter @replypilot/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @replypilot/api db:migrate",
    "db:deploy": "pnpm --filter @replypilot/api db:deploy",
    "db:generate": "pnpm --filter @replypilot/api db:generate",
    "seed": "pnpm --filter @replypilot/api seed",
    "allow-signup": "pnpm --filter @replypilot/api allow-signup"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "prettier": "^3.7.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
