NODE_ENV=local
PORT=4000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000
JWT_SECRET=change-me
AES_SECRET_KEY=change-me

DB_HOST=localhost
DB_PORT=5432
DB_NAME=replypilot
DB_USER=
DB_PASSWORD=

# mock = fake Google for everything; live = real Google sign-in and API calls
# Redirect URI for the OAuth client: {BACKEND_URL}/api/v1/google/callback
GBP_PROVIDER=mock
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Leave empty to use the built-in template drafter
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Seconds the mock Google takes to moderate a posted reply
MOCK_MODERATION_SECONDS=8
