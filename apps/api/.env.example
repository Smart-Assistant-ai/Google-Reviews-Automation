# Copy to .env. The app checks all of this at startup and refuses to run if something is wrong.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info

# The one address the app is served from. In development that is the Vite dev server,
# which forwards /api to this API.
APP_URL=http://localhost:5173

# Each environment gets its own database, user and password. Encode special characters in the password.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/replypilot_dev

# Generate both with: openssl rand -hex 32
JWT_SECRET=
ENCRYPTION_KEY=

# allowlist = only emails added with `pnpm allow-signup`. open = anyone. Production defaults to allowlist.
SIGNUP_MODE=open

# mock = a fake Google, so everything works before Google approves API access. live = real Google.
GBP_PROVIDER=mock
# off, mock or live. Production defaults to off.
GOOGLE_SIGNIN_PROVIDER=mock
# Needed when either of the above is live. Add these redirect URIs to the Google OAuth client:
#   {APP_URL}/api/v1/google/callback
#   {APP_URL}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only production posts to real Google by default. Set true here to test on your own profile.
# Set false in production as an emergency stop.
# GOOGLE_POSTING_ENABLED=false

# mock prints emails to the logs. resend sends them. Production requires resend.
EMAIL_PROVIDER=mock
RESEND_API_KEY=
EMAIL_FROM=ReplyPilot <hello@your-domain.com>

# Leave empty to use the built-in offline drafter.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Optional error tracking.
SENTRY_DSN=

# Seconds the mock Google takes to approve or reject a posted reply.
MOCK_MODERATION_SECONDS=8

# Set true to allow `pnpm seed`. Never set this on a real environment.
ALLOW_DB_SEED=true
# DEMO_PASSWORD=
